{
  "id": "goodai.content-api",
  "name": "Good'Ai content API",
  "version": "0.1.3",
  "apiVersion": 1,
  "description": "Read-only public JSON feed of published posts and services for the Next.js site.",
  "permissions": ["cms.routes", "cms.routes.public", "cms.content.read"],
  "entrypoints": { "server": "server/index.js" },
  "contentAccess": [
    { "table": "posts", "modes": ["read"] },
    { "table": "services", "modes": ["read"] }
  ]
}
